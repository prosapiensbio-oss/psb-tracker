{
  // ── JEDINÁ KONFIGURÁCIA NASADENIA ───────────────────────────────
  // Nasadzuje sa na účet prosapiensbio@gmail.com, cez `./scripts/nasad.sh`
  // alebo po pushi cez Cloudflare Workers Builds. Oboje číta TENTO súbor.
  //
  // Vedľa dlho ležala jeho kópia `wrangler.psb.jsonc`, ktorá o sebe tvrdila,
  // že nasadzovacia je ona — pritom skript ju nepoužíval. 25. 8. 2026 sa
  // väzba Workers AI pridaná do tej kópie ticho nenasadila a prejavilo sa to
  // ako chýbajúca väzba za behu. Kópia je preto preč a skript odovzdáva `-c`
  // výslovne. DRUHÝ KONFIG UŽ NEZAKLADAJ.
  //
  // Meno workera je zároveň adresa: kokpit.<účet>.workers.dev. Cieľ je
  // kokpit.prosapiens.cz — na to musí byť zóna prosapiens.cz na Cloudflare.

  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kokpit",
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Statické súbory sa servírujú priamo, všetko ostatné (vrátane "/") padá
  // na SSR Worker. run_worker_first zapnuté BYŤ NESMIE — Worker nemá trasu
  // na /assets/* a vracal by na ne 404.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // ŽIADNE ÚLOŽISKO NA ZÁLOHY — a je to zámer, nie opomenutie.
  //
  // Vlastná nočná záloha (dump všetkých tabuliek do KV) zhodila appku: na
  // voľnom pláne má worker 10 ms procesorového času na požiadavku a prepis
  // 5 000 riadkov do 2,5 MB JSON-u ho prekročí o rády. Opakované pokusy
  // zaškrtili celý worker a Kokpit vracal 503.
  //
  // D1 má pritom vlastné Time Travel: bod obnovy za posledných 30 dní, zadarmo
  // a bez jediného riadku kódu. Presne to, pred čím má záloha chrániť (zlý
  // import, nešťastné mazanie), rieši lepšie než čokoľvek, čo by sme napísali.
  // Kópia mimo Cloudflare zostáva ručným stiahnutím v Údajoch.

  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "5f34fff3-d3a3-44f2-a68d-57d9f6151749"
    }
  ],

  // Workers AI — generovanie obrázka do titulky, keď nie je čo odfotiť.
  // Je to VÄZBA, nie kľúč: beží na tom istom účte ako appka, takže tu nie je
  // čo nastavovať ani čo utajovať. Účtuje sa za obrázok (rádovo desatina
  // centa), preto sa volá len na kliknutie, nikdy sama.
  "ai": { "binding": "AI" },

  // Tajomstvá (PSB_PASSWORD, PSB_SESSION_SECRET, ANTHROPIC_API_KEY,
  // BTC_RESERVE_TOKEN) tu nie sú a nikdy tu byť nesmú — nastavujú sa cez
  // `wrangler secret put` a žijú len na Cloudflare.
  "vars": { "HF_ENV": "prod", "APP_SLUG": "kokpit" }
}
